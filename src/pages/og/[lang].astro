---
// 1200x630 social preview card (LinkedIn, WhatsApp, X). Rendered here, screenshotted to
// dist/og/cv-<lang>.png by scripts/build-assets.mjs, then this HTML page is deleted.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { Image } from 'astro:assets';
import photo from '../../assets/ender.png';
import { person } from '../../data/cv';
import { locales, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;

let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 70 }, () => ({ x: rnd() * 1200, y: rnd() * 630, r: 0.6 + rnd(), o: 0.15 + rnd() * 0.5 }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
  </head>
  <body>
    <div class="card">
      <svg class="sky" viewBox="0 0 1200 630" aria-hidden="true">
        {stars.map((s) => <circle cx={s.x.toFixed(0)} cy={s.y.toFixed(0)} r={s.r.toFixed(1)} fill="#e8e4dc" opacity={s.o.toFixed(2)} />)}
        <polyline points="980,90 1040,140 1110,120 1150,190" fill="none" stroke="#8cc8ec" stroke-opacity="0.3" />
        <polyline points="80,500 140,470 200,520 250,490" fill="none" stroke="#8cc8ec" stroke-opacity="0.3" />
      </svg>
      <div class="text">
        <p class="mark">EA</p>
        <h1>{person.name}</h1>
        <p class="title">{person.title[lang]}</p>
        <p class="url">pandomentall.github.io/{lang === 'en' ? 'en/' : ''}cv</p>
      </div>
      <Image class="photo" src={photo} alt="" width={300} height={300} format="webp" quality={90} />
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: #2e3844;
  }
  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 96px;
    box-sizing: border-box;
    overflow: hidden;
    background: #2e3844;
    color: #e8e4dc;
    font-family: 'Geist Variable', sans-serif;
  }
  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .text {
    position: relative;
    max-width: 680px;
  }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 0 28px;
    border-radius: 14px;
    background: #8cc8ec;
    color: #1d2833;
    font: 700 20px 'Geist Mono Variable', monospace;
  }
  h1 {
    margin: 0;
    font-size: 88px;
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .title {
    margin: 18px 0 0;
    font-size: 34px;
    color: #8cc8ec;
  }
  .statement {
    margin: 16px 0 0;
    font-size: 26px;
    color: #aeb8c4;
  }
  .url {
    margin: 40px 0 0;
    font: 500 22px 'Geist Mono Variable', monospace;
    color: #e9b98b;
  }
  .photo {
    position: relative;
    width: 260px;
    height: 260px;
    border-radius: 56px;
    object-fit: cover;
    outline: 2px solid #45515e;
    outline-offset: 8px;
  }
</style>
