---
// CV backdrop: a faint, static star field with a few constellations (Ellam is a moon —
// a quiet nod to the game universe). Generated at build time with a fixed seed, so the
// sky is identical on every visit and costs no JS. Stars twinkle and drift with scroll
// via CSS only; both are disabled for reduced motion.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(240603);
const W = 1600;
const H = 1100;

const stars = Array.from({ length: 120 }, () => ({
  x: rnd() * W,
  y: rnd() * H,
  r: 0.5 + rnd() * 1.1,
  o: 0.25 + rnd() * 0.55,
  twinkle: rnd() < 0.22,
  delay: -(rnd() * 6).toFixed(2),
  dur: (3.5 + rnd() * 4).toFixed(2),
}));

// Constellations sit mostly toward the edges so text stays clean.
const anchors = [
  [140, 160], [1420, 120], [1480, 620], [90, 720], [1250, 960], [380, 1000], [760, 80],
];
const constellations = anchors.map(([ax, ay]) => {
  const n = 4 + Math.floor(rnd() * 3);
  let x = ax;
  let y = ay;
  return Array.from({ length: n }, () => {
    x += (rnd() - 0.4) * 110;
    y += (rnd() - 0.5) * 90;
    return [Math.round(x), Math.round(y)] as const;
  });
});
---

<div class="backdrop constellation" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <g class="lines">
      {constellations.map((pts) => <polyline points={pts.map((p) => p.join(',')).join(' ')} />)}
    </g>
    <g class="nodes">
      {constellations.flat().map(([x, y]) => <circle cx={x} cy={y} r="1.8" />)}
    </g>
    <g class="stars">
      {
        stars.map((s) => (
          <circle
            cx={s.x.toFixed(1)}
            cy={s.y.toFixed(1)}
            r={s.r.toFixed(2)}
            opacity={s.o.toFixed(2)}
            class={s.twinkle ? 'tw' : undefined}
            style={s.twinkle ? `animation-delay:${s.delay}s;animation-duration:${s.dur}s` : undefined}
          />
        ))
      }
    </g>
  </svg>
</div>

<style>
  .constellation svg {
    position: absolute;
    inset: -4% 0 auto;
    width: 100%;
    height: 112%;
    /* Keep the reading column quiet: stars fade toward the centre. */
    mask-image: radial-gradient(ellipse 55% 60% at 55% 45%, transparent 0%, #000 85%);
  }
  .lines polyline {
    fill: none;
    stroke: #8cc8ec;
    stroke-opacity: 0.14;
    stroke-width: 1;
  }
  .nodes circle {
    fill: #8cc8ec;
    opacity: 0.45;
  }
  .stars circle {
    fill: #e8e4dc;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tw {
      animation: twinkle ease-in-out infinite alternate;
    }
    @supports (animation-timeline: scroll()) {
      .constellation svg {
        animation: drift linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes twinkle {
    to {
      opacity: 0.08;
    }
  }
  @keyframes drift {
    to {
      transform: translateY(-3%);
    }
  }
</style>
