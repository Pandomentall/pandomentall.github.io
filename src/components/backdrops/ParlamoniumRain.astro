---
// Game-zone backdrop: Ellam's endless Parlamonium storm. Gold streaks (with the odd
// purple discharge) fall at a slant over a large moon silhouette. Everything is very
// translucent — atmosphere, not a show. Parallax: the moon and the far layer move a
// few percent with scroll (CSS scroll timeline), nothing moves sideways or zooms.
// Reduced motion: one still frame, no animation.
---

<div class="backdrop rain" aria-hidden="true">
  <div class="rain__far"></div>
  <svg class="rain__moon" viewBox="0 0 1000 1000">
    <defs>
      <radialGradient id="moon-body" cx="38%" cy="32%" r="70%">
        <stop offset="0%" stop-color="#3a4557" />
        <stop offset="70%" stop-color="#2a3240" />
        <stop offset="100%" stop-color="#262e39" />
      </radialGradient>
      <linearGradient id="moon-rim" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f2c572" stop-opacity="0.55" />
        <stop offset="55%" stop-color="#b9a2f5" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#b9a2f5" stop-opacity="0" />
      </linearGradient>
    </defs>
    <circle cx="500" cy="500" r="480" fill="url(#moon-body)" />
    <circle cx="500" cy="500" r="480" fill="none" stroke="url(#moon-rim)" stroke-width="3" />
    <g fill="#262e39" opacity="0.55">
      <circle cx="360" cy="330" r="62" />
      <circle cx="600" cy="560" r="94" />
      <circle cx="450" cy="700" r="40" />
      <circle cx="700" cy="300" r="28" />
    </g>
  </svg>
  <canvas class="rain__canvas"></canvas>
</div>

<script>
  import { fitCanvas, reducedMotion } from '../../scripts/parlavan';

  const canvas = document.querySelector<HTMLCanvasElement>('.rain__canvas');
  if (canvas) start(canvas);

  function start(canvas: HTMLCanvasElement) {
    type Drop = { x: number; y: number; v: number; len: number; a: number; purple: boolean };
    const SLANT = 0.32; // horizontal drift per unit of fall (falls down-left)
    let ctx = fitCanvas(canvas);
    let w = canvas.clientWidth;
    let h = canvas.clientHeight;
    let drops: Drop[] = [];

    const spawn = (anywhere: boolean): Drop => ({
      x: Math.random() * (w + h * SLANT),
      y: anywhere ? Math.random() * h : -40 - Math.random() * 200,
      v: 70 + Math.random() * 170,
      len: 10 + Math.random() * 34,
      a: 0.08 + Math.random() * 0.3,
      purple: Math.random() < 0.18,
    });

    const reset = () => {
      ctx = fitCanvas(canvas);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      const count = Math.min(110, Math.round((w * h) / 14000));
      drops = Array.from({ length: count }, () => spawn(true));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.lineCap = 'round';
      for (const d of drops) {
        const color = d.purple ? '185,162,245' : '242,197,114';
        const tailX = d.x + d.len * SLANT;
        const tailY = d.y - d.len;
        const g = ctx.createLinearGradient(tailX, tailY, d.x, d.y);
        g.addColorStop(0, `rgba(${color},0)`);
        g.addColorStop(1, `rgba(${color},${d.a})`);
        ctx.strokeStyle = g;
        ctx.lineWidth = d.purple ? 1 : 1.4;
        ctx.beginPath();
        ctx.moveTo(tailX, tailY);
        ctx.lineTo(d.x, d.y);
        ctx.stroke();
        ctx.fillStyle = `rgba(${color},${Math.min(1, d.a * 1.8)})`;
        ctx.fillRect(d.x - 0.8, d.y - 0.8, 1.6, 1.6);
      }
    };

    reset();
    addEventListener('resize', reset);

    if (reducedMotion()) {
      draw();
      return;
    }

    let last = performance.now();
    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      for (let i = 0; i < drops.length; i++) {
        const d = drops[i];
        d.y += d.v * dt;
        d.x -= d.v * dt * SLANT;
        if (d.y - d.len > h || d.x < -60) drops[i] = spawn(false);
      }
      draw();
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick); // rAF pauses by itself in background tabs
  }
</script>

<style>
  .rain__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .rain__moon {
    position: absolute;
    width: min(78vw, 900px);
    right: -22vw;
    bottom: -38vh;
    opacity: 0.55;
  }
  /* Far layer: tiny distant debris, drifts slower than the moon. */
  .rain__far {
    position: absolute;
    inset: -10% 0;
    opacity: 0.5;
    background-image:
      radial-gradient(1px 1px at 12% 18%, #f2c572, transparent),
      radial-gradient(1px 1px at 34% 62%, #b9a2f5, transparent),
      radial-gradient(1px 1px at 58% 24%, #e8e4dc, transparent),
      radial-gradient(1px 1px at 76% 48%, #f2c572, transparent),
      radial-gradient(1px 1px at 88% 12%, #e8e4dc, transparent),
      radial-gradient(1px 1px at 22% 84%, #e8e4dc, transparent),
      radial-gradient(1px 1px at 66% 78%, #b9a2f5, transparent);
    background-size: 420px 420px;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .rain__moon {
        animation: moon-rise linear both;
        animation-timeline: scroll(root);
      }
      .rain__far {
        animation: far-drift linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes moon-rise {
    to {
      transform: translateY(-9vh);
    }
  }
  @keyframes far-drift {
    to {
      transform: translateY(-4vh);
    }
  }
</style>
