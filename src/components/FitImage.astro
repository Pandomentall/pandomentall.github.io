---
// An image that is never cropped: it fits whole inside whatever box the parent gives it
// (object-fit: contain), and the empty bands are filled by a small, blurred, dimmed copy of
// the same image. The fill is marked data-fill so the build's crop check skips it
// (scripts/build-assets.mjs). Parents may scale the fill on hover, never the image itself.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  width: number;
  alt?: string;
  quality?: number;
  loading?: 'eager' | 'lazy';
}
const { src, width, alt = '', quality = 78, loading = 'lazy' } = Astro.props;
---

<span class="fit">
  <Image class="fit__fill" data-fill src={src} alt="" aria-hidden="true" width={160} format="webp" quality={50} loading={loading} />
  <Image class="fit__img" src={src} alt={alt} width={width} format="webp" quality={quality} loading={loading} />
</span>

<style>
  .fit {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .fit :global(.fit__fill) {
    position: absolute;
    inset: -10%;
    width: 120%;
    max-width: none;
    height: 120%;
    object-fit: cover;
    filter: blur(14px) brightness(0.55) saturate(1.1);
    transition: transform 900ms var(--ease);
  }
  .fit :global(.fit__img) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
